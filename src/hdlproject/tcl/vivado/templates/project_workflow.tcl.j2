# project_workflow.tcl - Generated by hdlproject
# Mode: {{ mode }} | Project: {{ project_name }} | Part: {{ part }}
#
# This file is auto-generated from Jinja2 templates. Do not edit directly.
# To customise behaviour, use hooks in hdlproject_project_config.yaml.

package require json

variable script_dir [file dirname [file normalize [info script]]]

# Source static modules
source "$script_dir/common.tcl"
source "$script_dir/config.tcl"
source "$script_dir/build.tcl"
source "$script_dir/handle_xcis.tcl"
source "$script_dir/handle_source_files.tcl"
source "$script_dir/handle_bds.tcl"
source "$script_dir/handle_constraints.tcl"

# =============================================================================
# Configuration
# =============================================================================

common::log_status "======= Vivado Project Management System ======="
common::log_status "Mode: {{ mode }}"
common::log_status "Loading configuration from: {{ config_file }}"

set result [config::load_config "{{ config_file }}"]
if {[dict get $result status] eq "error"} { exit 1 }

set project_info [config::get_project_info]
set device_info [config::get_device_info]

# =============================================================================
# Load Compile Order
# =============================================================================

set compile_order_file "{{ operation_dir }}/compile_order.json"
common::log_status "Loading compile order from: $compile_order_file"

if {![file exists $compile_order_file]} {
    common::log_error "project_workflow" "Compile order file not found: $compile_order_file"
    exit 1
}

if {[catch {
    set fh [open $compile_order_file r]
    set compile_order_dict [json::json2dict [read $fh]]
    close $fh
} error_msg]} {
    common::log_error "project_workflow" "Failed to parse compile order file: $error_msg"
    exit 1
}

if {![dict exists $compile_order_dict files]} {
    common::log_error "project_workflow" "Missing 'files' key in compile order JSON"
    exit 1
}
set files_list [dict get $compile_order_dict files]

# =============================================================================
# Project Creation
# =============================================================================

common::log_status "Setting up Project..."

file mkdir "{{ vivado_project_dir }}"
file mkdir "{{ bd_dir }}"
file mkdir "{{ xci_dir }}"

# Create .gitignore files
foreach dir [list "{{ bd_dir }}" "{{ vivado_project_dir }}"] {
    set gitignore_file "$dir/.gitignore"
    set fid [open $gitignore_file "w"]
    puts $fid "*"
    close $fid
}

create_project -force "{{ project_name }}" "{{ vivado_project_dir }}" -part {{ part }}

set obj [current_project]
{% if board_part %}
set_property -name "board_part" -value "{{ board_part }}" -objects $obj
{% endif %}
{% if board_name %}
set_property -name "platform.board_id" -value "{{ board_name }}" -objects $obj
{% endif %}

# Standard project properties
set_property -name "default_lib" -value "{{ default_library }}" -objects $obj
set_property -name "enable_vhdl_2008" -value "1" -objects $obj
set_property -name "ip_cache_permissions" -value "read write" -objects $obj
set_property -name "ip_output_repo" -value "{{ vivado_project_dir }}/{{ project_name }}.cache/ip" -objects $obj
set_property -name "mem.enable_memory_map_generation" -value "1" -objects $obj
set_property -name "sim.central_dir" -value "{{ vivado_project_dir }}/{{ project_name }}.ip_user_files" -objects $obj
set_property -name "sim.ip.auto_export_scripts" -value "1" -objects $obj
set_property -name "simulator_language" -value "Mixed" -objects $obj
set_property -name "target_language" -value "VHDL" -objects $obj
set_property -name "xpm_libraries" -value "XPM_CDC XPM_FIFO XPM_MEMORY" -objects $obj

# Create filesets
if {[string equal [get_filesets -quiet sources_1] ""]} {
    create_fileset -srcset sources_1
}
handle_source_files::create_sim_fileset

{% if hooks.post_project_create %}
# === User Hook: post_project_create ===
{% for cmd in hooks.post_project_create %}
{{ cmd }}
{% endfor %}
{% endif %}

# Initialise project context
project_context::initialise
{% if artefact_name %}
project_context::set_name "{{ artefact_name }}"
{% endif %}

# =============================================================================
# Process Project Components
# =============================================================================

set workflow_has_errors 0
set workflow_has_warnings 0

{% if mode == "build" %}
set script_mode $common::BUILD_MODE
{% elif mode == "open" %}
set script_mode $common::OPEN_MODE
{% elif mode == "export" %}
set script_mode $common::EXPORT_MODE
{% endif %}

# Handle XCIs
set result [handle_xcis::process_xcis $files_list "{{ vivado_project_dir }}" $script_mode "{{ xci_dir }}"]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

# Handle source files
set result [handle_source_files::process_source_files $files_list]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

{% if generated_source_files %}
# Add generated source files (rendered from Jinja2 templates by hdlproject)
common::log_status "Adding generated source files..."
{% for file_path in generated_source_files %}
if {[file exists "{{ file_path }}"]} {
    add_files -norecurse -fileset [get_filesets sources_1] "{{ file_path }}"
    common::log_info "\tAdded generated source: {{ file_path }}"
} else {
    common::log_error "project_workflow" "Generated source file not found: {{ file_path }}"
    set workflow_has_errors 1
}
{% endfor %}
{% endif %}

# Handle constraints
set result [handle_constraints::process_constraints $files_list]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

# Handle block designs
set result [handle_bds::process_bds $files_list "{{ vivado_project_dir }}" "{{ bd_dir }}"]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

# Set top level
set result [handle_source_files::set_top_level "{{ top_level }}"]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

# Configure synthesis settings
source "$script_dir/handle_synth_settings.tcl"

set result [handle_synth_settings::configure_synth_settings "{{ part }}" "{{ tool_version_year }}"]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

set result [handle_synth_settings::apply_custom_synth_options]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

# Configure implementation settings
source "$script_dir/handle_impl_settings.tcl"

set result [handle_impl_settings::configure_impl_settings "{{ part }}" "{{ tool_version_year }}"]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

set result [handle_impl_settings::apply_custom_impl_options]
if {[dict get $result status] eq "error"} {
    set workflow_has_errors 1
} elseif {[dict get $result status] eq "warning"} {
    set workflow_has_warnings 1
}

{% if hooks.post_project_setup %}
# === User Hook: post_project_setup ===
{% for cmd in hooks.post_project_setup %}
{{ cmd }}
{% endfor %}
{% endif %}

# =============================================================================
# Check for errors before proceeding
# =============================================================================

if {$workflow_has_errors} {
    common::log_error "project_workflow" "One or more steps failed during project setup"
    exit 1
}

# =============================================================================
# Execute Operation
# =============================================================================

{% if mode == "build" %}
{% include "build.tcl.j2" %}
{% elif mode == "open" %}
{% include "open.tcl.j2" %}
{% elif mode == "export" %}
{% include "export.tcl.j2" %}
{% endif %}
